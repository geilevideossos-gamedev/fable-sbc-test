	(text "UART: PA05 = module TX -> GPIO9 (RXD4), PA06 = module RX <- GPIO8 (TXD4),\nPA07 = module CTS <- GPIO11 (RTS4), PA08 = module RTS -> GPIO10 (CTS4).\nPC00 = bootloader entry, active low (GPIO25), RESET = GPIO24. SWD also wired to GPIO22/23\nso the CM4 can flash the radio in-system (openocd bit-bang)."
