	(text "UART: DIO13 = module TX -> GPIO9 (RXD4), DIO12 = module RX <- GPIO8 (TXD4),\nDIO18 = module RTS -> GPIO10 (CTS4), DIO19 = module CTS <- GPIO11 (RTS4)  [TI LAUNCHXL-CC1352P-2 assignment].\nDIO15 = ROM bootloader backdoor, active low (GPIO25). Reset: GPIO24 HIGH pulls RES low (open drain).\nJTAG for recovery: TMS = GPIO22, TCK = GPIO23, TDO = GPIO17, TDI = GPIO7 (4-wire, OpenOCD bit-bang)."
		(exclude_from_sim no)
